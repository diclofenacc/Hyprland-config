* { 
    background:                  #282828FF;
    background-alt:              #353535FF;
    foreground:                  #EBDBB2FF;
    selected:                    #83A598FF;
    active:                      #B8BB26FF;
    urgent:                      #FB4934FF;
    lightbg:                     @background;
    lightfg:                     @foreground;

    alternate-normal-background: @background;
    alternate-active-background: @active;
    alternate-urgent-background: @urgent;
}
